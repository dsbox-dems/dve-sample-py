#  -*- mode: conf; -*- vim: set ft=conf:
## =============================================================================
# .env.defaults: environment (.env) template
#
# ------------------------------------------------------------------------------
#  Usage: 
#
#  - copy .env.defaults as .env (git ignored)
#  - customize locally .env with secrets (API tokens, DB Passwords)
#  - activate environment with `uv run` (e.g. `uv run $SHELL`)
#  - verify environment with `env | sort`
#
#  Alternative Usage:
#
#  - parallel clone of a Git managed config project
#  - symbolic link (from project root):
#
#    `ln -s ../project-conf/envs/staging/.env .env`
#
#
#  NOTE:
#  - never commit in Git credentials and passwords
#  - define in defaults only configurations data for:
#    - public resources with anonymous access (e.g. PyPI repositories)
#    - cloud resuorces with external authentication (Azure Container Registry)
#    - local service (local MySQL user credentils)
# ===============================================================================
#

## Default Azure Container Regitry

ACR_RESOURCE=svsi680reg
ACR_REGISTRY=svsi680reg.azurecr.io


## Torch CUDA package repository
E_UV_INDEX_TORCH_GPU=https://download.pytorch.org/whl/cu130


# --- DO NOT COMMIT THESE VARIABLES ------------------------------------

## GitHub Access Token
# GITHUB_PAT_TOKEM=<put here Github PAT token>

## PostgreSQL Admin password
# POSTGRES_ADMIN_PASSWD=<put here Postgres DBA password>


# ===============================================================================
