{
  "build": {
    "dockerfile": "../docker/r-images/dockerfiles/runtime.Dockerfile"
  },
  "name": "./runtime.sh dev -- project container",
  "remoteUser": "root",
  "workspaceFolder": "/root/work",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.debugpy"      
      ],
      "settings": {
       // Ensure Python uses the uv-created virtualenv
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvInSelectedTerminal": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "[python]": {
            "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "always",
            "source.organizeImports.ruff": "always"
          }
       }      
    }
  },
  // Required for rootless podman to avoid permission issues
  "containerUser": "root",
  // "updateRemoteUserUID": true  ,
  "forwardPorts": [],
  "postCreateCommand": "# echo 'uv run $SHELL'"
}
